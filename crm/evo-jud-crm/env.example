# =====================================================================
# britto-wizard · evo-jud-crm · variáveis da instalação
# O wizard copia para /opt/britto/.env (chmod 600) e preenche os __GERAR_*__.
# NUNCA versione nem cole o .env em chat.
# =====================================================================

# --- Organização ---
ORG_NAME=Meu Escritório

# --- Domínios (todos apontando para o IP da VPS: registro A) ---
HOST_PORTAINER=portainer.exemplo.com.br
HOST_CRM=crm.exemplo.com.br
HOST_API_CRM=api-crm.exemplo.com.br
HOST_WHATSAPP=whatsapp.exemplo.com.br
HOST_MCP=mcp.exemplo.com.br
HOST_DOCUSEAL=assinatura.exemplo.com.br

# --- Let's Encrypt ---
ACME_EMAIL=tecnico@exemplo.com.br

# --- SMTP (convites, recuperação de senha). Gmail: smtp.gmail.com, 587, senha de app ---
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=exemplo.com.br
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=

# --- Cadastro público: aberto só até criar a 1ª conta (o wizard fecha depois) ---
ENABLE_ACCOUNT_SIGNUP=true
SIGNUP_ALLOW_RANGE=0.0.0.0/0

# --- Dashboard Apps com ponte (origens https separadas por vírgula; vazio = nenhuma) ---
DASHBOARD_APP_ORIGINS=

# --- Evolution Go ---
EVOGO_CLIENT_NAME=britto

# --- Usuários internos ---
CLICKHOUSE_USER=default
RABBITMQ_USER=evoflow
REDIS_PASSWORD=

# --- Segredos (gerados pelo wizard) ---
PGVECTOR_PASSWORD=__GERAR_HEX32__
POSTGRES_EVOGO_PASSWORD=__GERAR_HEX32__
SECRET_KEY_BASE=__GERAR_HEX128__
JWT_SECRET_KEY=__GERAR_HEX64__
DOORKEEPER_JWT_SECRET_KEY=__GERAR_HEX64__
EVOAI_CRM_API_TOKEN=__GERAR_HEX64__
ENCRYPTION_KEY=__GERAR_FERNET__
BOT_RUNTIME_SECRET=__GERAR_HEX64__
EVOFLOW_INTEGRATION_KEY=__GERAR_HEX64__
CLICKHOUSE_PASSWORD=__GERAR_HEX32__
RABBITMQ_PASSWORD=__GERAR_HEX32__
EVOGO_GLOBAL_API_KEY=__GERAR_HEX32__
DOCUSEAL_SECRET_KEY_BASE=__GERAR_HEX128__
